{
  "name": "nenrin",
  "private": true,
  "version": "0.9.0",
  "description": "Local-first, open-source flashcard app with FSRS spaced repetition. An MIT alternative to Anki.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "brand": "node scripts/generate-brand.mjs",
    "screenshots": "vite build && node scripts/screenshots.mjs",
    "check:decks": "node scripts/check-decks.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "fsrs-browser": "^6.6.0",
    "fzstd": "^0.1.1",
    "katex": "^0.19.1",
    "marked": "^18.1.1",
    "pele": "^1.10.0",
    "sql.js": "^1.15.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
